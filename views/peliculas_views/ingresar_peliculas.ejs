<%-include("../components/head.ejs")%>

  <body>

    <%-include("../components/nav.ejs")%>
    <main>
      <h1>Ingresar <%= title %></h1>

      <form class="formEntidad" id="formIngresarPelicula">

        <label id="titulo">Título
          <input id="titulo_input" type="text" name="titulo">
        </label><br>

        <label id="anio">Año
          <input id="anio_input" type="number" name="anio">
        </label><br>

        <label id="duracion">Duración
          <input id="duracion_input" type="number" name="duracion">
        </label><br>

        <div>
          <label id="id_clasificacion">----- Clasificación -----</label><br>
            <% if(clasificaciones_list.length > 0) { %>
              <% clasificaciones_list.forEach((cl, i) => { %>

                <label>
                  <%= cl.nombre %>
                  <input type="radio" value="<%= cl.id_clasificacion %>" name="id_clasificacion">
                </label><br>

              <% }); %>
            <% } else { %>
              <p>No hay Clasificaciones para asignar</p>
            <% } %>
        </div>

        <div>
          <label id="categorias">----- Categorías -----</label><br>
            <% if(categorias_list.length > 0) { %>
              <% categorias_list.forEach((c, i) => { %>

                <label>
                  <%= c.nombre %>
                  <input type="checkbox" value="<%= c.id_categoria %>" name="categorias">
                </label><br>

              <% }); %>
            <% } else { %>
              <p>No hay Categorías para asignar</p>
            <% } %>
        </div>

        <div>
          <label id="directores">----- Directores -----</label><br>
            <% if(directores_list.length > 0) { %>
              <% directores_list.forEach((d, i) => { %>

                <label>
                  <%= d.nombre %> <%= d.apellido %>
                  <input type="checkbox" value="<%= d.id_director %>" name="directores">
                </label><br>

              <% }); %>
            <% } else { %>
              <p>No hay Directores para asignar</p>
            <% } %>
        </div>

        <button class="formEntidad__submit" type="button" onclick="enviarFormulario()">Enviar</button>

      </form>
    </main>
    
    <script src="/javascripts/peliculas/ingresar_peliculas.js"></script>

  </body>

  <%-include("../components/footer.ejs")%>