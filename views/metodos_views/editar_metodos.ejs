<%-include("../components/head.ejs")%>

  <body>
    <%-include("../components/nav.ejs")%>
      <main>
        <h1><%= title %>: <%= metodo.nombre %></h1>

        <form class="formEntidad" id="formEditarMetodo">

          <label id="nombre">Nombre
            <input type="text" id="nombre_input" name="nombre" value="<%= metodo.nombre %>">
          </label><br>

          <button class="formEntidad__submit" type="button" onclick="actualizarMetodo('<%= metodo.id_metodo %>')">Guardar Cambios</button>

        </form>
      </main>

      <script src="/javascripts/metodos/actualizar_metodos.js"></script>

  </body>

  <%-include("../components/footer.ejs")%>