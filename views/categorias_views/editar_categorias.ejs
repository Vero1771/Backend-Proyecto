<%-include("../components/head.ejs")%>

  <body>
    <%-include("../components/nav.ejs")%>
      <main>
        <h1><%= title %>: <%= categoria.nombre %></h1>

        <form class="formEntidad" id="formEditarCategoria">

          <label id="nombre">Nombre
            <input type="text" id="nombre_input" name="nombre" value="<%= categoria.nombre %>" >
          </label><br>

          <button class="formEntidad__submit" type="button" onclick="actualizarCategoria('<%= categoria.id_categoria %>')">Guardar Cambios</button>

        </form>
      </main>

      <script src="/javascripts/categorias/actualizar_categorias.js"></script>

  </body>

  <%-include("../components/footer.ejs")%>