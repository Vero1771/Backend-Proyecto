<%-include("../components/head.ejs")%>
  <body>

    <%-include("../components/nav.ejs")%>
    <main>
      <h1><%= title %></h1>

      <% if(categorias_list.length <= 0) { %>
        <h2>No hay categorías registradas</h2>
      <% }  %>

      <table>
          <thead>
              <tr>
                  <th>ID</th>
                  <th>Nombre</th>
                  <th>Administrar</th>
              </tr>
          </thead>
          <tbody>
              <% categorias_list.forEach((c, i) => { %>
                  <tr>
                      <td><%= c.id_categoria %></td>
                      <td><%= c.nombre %></td>
                      <td>    
                        <div class="botonera">
                          <a class="botonera__opcion opcion__editar" href="/categorias/actualizar/<%= c.id_categoria %>" class="button">Editar</a>
                          <button class="botonera__opcion opcion__eliminar" onclick="eliminarCategoria(this, '<%= c.id_categoria %>')"> X </button>
                        </div>
                      </td>
                  </tr>
              <% }); %>
          </tbody>
      </table>
    </main>

    <script src="/javascripts/categorias/eliminar_categorias.js"></script>

  </body>

<%-include("../components/footer.ejs")%>