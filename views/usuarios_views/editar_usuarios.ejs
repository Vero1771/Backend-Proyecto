<%-include("../components/head.ejs")%>

  <body>
    <%-include("../components/nav.ejs")%>
      <main>
        <h1><%= title %>: <%= usuario.email %></h1>

        <form class="formEntidad" id="formEditarUser">

          <label id="email">Email
            <input type="email" name="email" value="<%= usuario.email %>" id="email_input">
          </label><br>

          <label id="password">Nueva Contraseña
            <input type="password" name="password" id="password_input">
          </label><br>

          <button class="formEntidad__submit" type="button" onclick="actualizarUsuario('<%= usuario.id_usuario %>')">Guardar Cambios</button>

        </form>
      </main>

      <script src="/javascripts/usuarios/actualizar_usuarios.js"></script>

  </body>

  <%-include("../components/footer.ejs")%>