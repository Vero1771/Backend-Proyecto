<%-include("../components/head.ejs")%>

  <body>
    <%-include("../components/nav.ejs")%>
    <main>
      <h1><%= title %></h1>

      <div id="lista-entradas">
        <table class="table"> 
          <thead>
            <tr>
              <th>Seleccionar</th> <th>ID</th>
              <th>Película</th>
              <th>Asiento</th>
              <th>Fecha Función</th>
              <th>Precio</th>
            </tr>
          </thead>
          <tbody>
            <% entradas_list.forEach((e) => { %>
              <tr class="entradas-fila" data-id="<%= e.id_entrada %>" data-precio="<%= e.precio %>">
                <td>
                  <input type="checkbox" class="entrada-checkbox" onchange="actualizarTotal()">
                </td>
                <td><%= e.id_entrada %></td>
                <td><%= e.pelicula %></td>
                <td><%= e.asiento %></td>
                <td><%= e.fecha_funcion.toLocaleString('es-ES') %></td>
                <td>$<%= e.precio %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      
      <div class="formEntidad">
        <div class="row">
          <label>Método de Pago:</label>
          <select id="id_metodo">
            <% metodos_pago_list.forEach(m => { %>
              <option value="<%= m.id_metodo %>"><%= m.nombre %></option>
            <% }) %>
          </select>
        </div>

        <h4>Total Venta: $<span id="total-general">0.00</span></h4>
        <button class="formEntidad__submit" type="button" onclick="enviarVenta()">Finalizar Venta de Entradas</button>
      </div>
    </main>

    <script src="/javascripts/entradas/comprar_entradas.js"></script>

  </body>

  <%-include("../components/footer.ejs")%>