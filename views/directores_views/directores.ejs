<%-include("../components/head.ejs")%>
  <body>

    <%-include("../components/nav.ejs")%>

    <main>
      <h1><%= title %></h1>

      <% if(directores_list.length <= 0) { %>
        <h2>No hay directores registrados</h1>
      <% }  %>

      <table>
          <thead>
              <tr>
                  <th>ID</th>
                  <th>Nombre</th>
                  <th>Apellido</th>
                  <% if (user && user.rol === 'admin') { %>
                    <th>Administrar</th>
                  <% } %>
              </tr>
          </thead>
          <tbody>
              <% directores_list.forEach((d, i) => { %>
                  <tr>
                    <td><%= d.id_director %></td>
                    <td><%= d.nombre %></td>
                    <td><%= d.apellido %></td>
                    
                    <% if (user && user.rol === 'admin') { %>
                      <td>    
                        <div class="botonera">
                          <a class="botonera__opcion opcion__editar" href="/directores/actualizar/<%= d.id_director %>" class="button">Editar</a>
                          <button class="botonera__opcion opcion__eliminar" onclick="eliminarDirector(this, '<%= d.id_director %>')"> X </button> 
                        </div>
                      </td>
                    <% } %>

                  </tr>
              <% }); %>
          </tbody>
      </table>
    </main>

    <script src="/javascripts/directores/eliminar_directores.js"></script>

  </body>

<%-include("../components/footer.ejs")%>