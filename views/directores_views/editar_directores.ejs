<%-include("../components/head.ejs")%>

  <body>
    <%-include("../components/nav.ejs")%>
      <main>
        <h1><%= title %>: <%= director.nombre %></h1> 

        <form class="formEntidad" id="formEditardirector">
          <label>Nombre
            <input type="text" id="nombre_input" name="nombre" value="<%= director.nombre %>"> 
          </label><br>

          <label>Apellido
            <input type="text" id="apellido_input" name="apellido" value="<%= director.apellido %>"> 
          </label><br>

          <button class="formEntidad__submit" type="button" onclick="actualizarDirector('<%= director.id_director %>')">Guardar Cambios</button>
        </form>
      </main>

      <script src="/javascripts/directores/actualizar_directores.js"></script>

  </body>

  <%-include("../components/footer.ejs")%>