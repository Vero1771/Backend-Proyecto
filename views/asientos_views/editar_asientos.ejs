<%-include("../components/head.ejs")%>

  <body>
    <%-include("../components/nav.ejs")%>
      <main>
        <h1><%= title %>: <%= asiento.nombre %></h1>

        <form class="formEntidad" id="formEditarAsiento">

          <label id="nombre">Nombre
            <input type="text" id="nombre_input" name="nombre" value="<%= asiento.nombre %>">
          </label><br>

          <button class="formEntidad__submit" type="button" onclick="actualizarAsiento('<%= asiento.id_asiento %>')">Guardar Cambios</button>

        </form>

      </main>

      <script src="/javascripts/asientos/actualizar_asientos.js"></script>

  </body>

  <%-include("../components/footer.ejs")%>