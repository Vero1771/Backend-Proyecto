<%-include("../components/head.ejs")%>
  <body>

    <%-include("../components/nav.ejs")%>
    <main>
      <h1><%= title %></h1>

      <% if(asientos_list.length <= 0) { %>
        <h2>No hay asientos registrados</h2>
      <% }  %>

      <table>
          <thead>
              <tr>
                  <th>ID</th>
                  <th>Nombre</th>
                  <th>Administrar</th>
              </tr>
          </thead>
          <tbody>
              <% asientos_list.forEach((a, i) => { %>
                  <tr>
                      <td><%= a.id_asiento %></td>
                      <td><%= a.nombre %></td>
                      <td>    
                        <div class="botonera">
                          <a class="botonera__opcion opcion__editar" href="/asientos/actualizar/<%= a.id_asiento %>" class="button">Editar</a>
                          <button class="botonera__opcion opcion__eliminar" onclick="eliminarAsiento(this, '<%= a.id_asiento %>')"> X </button>
                        </div>
                      </td>
                  </tr>
              <% }); %>
          </tbody>
      </table>

    </main>

    <script src="/javascripts/asientos/eliminar_asientos.js"></script>

  </body>

<%-include("../components/footer.ejs")%>