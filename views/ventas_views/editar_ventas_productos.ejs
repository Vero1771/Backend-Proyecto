<%-include("../components/head.ejs")%>

  <body>
    <%-include("../components/nav.ejs")%>
      <main>
        <h1><%= title %>: <%= venta.id_venta_producto %></h1>

        <form class="formEntidad" id="formEditarVentaProducto">

          <div class="row">
            <label>Producto:</label>
            <select id="id_producto" name="id_producto">
              <% productos_list.forEach((p) => { %>
                <option value="<%= p.id_producto %>"
                  <%= p.id_producto == venta.id_producto ? 'selected' : '' %>>
                  <%= p.nombre %>
                </option>
              <% }); %>
            </select>
          </div>

          <br>

          <label id="cantidad">Cantidad
            <input type="number" name="cantidad" value="<%= venta.cantidad %>" id="cantidad_input">
          </label><br>

          <label id="subtotal">SubTotal
            <input type="number" step="0.01" name="subtotal" value="<%= venta.subtotal %>" id="subtotal_input">
          </label><br>

          <button class="formEntidad__submit" type="button" onclick="actualizarVentaProducto('<%= venta.id_venta_producto %>')">Guardar Cambios</button>

        </form>
      </main>

      <script src="/javascripts/ventas/actualizar_ventasProductos.js"></script>

  </body>

  <%-include("../components/footer.ejs")%>