<%-include("../components/head.ejs")%>
<body>
  <%-include("../components/nav.ejs")%>
  <main>
      <h1><%= title %>: <%= product.nombre %></h1>

      <form class="formEntidad" id="formEditarProducto">

          <label id="nombre">Nombre
            <input type="text" name="nombre" value="<%= product.nombre %>" id="nombre_input">
          </label><br>

          <label id="cantidad">Cantidad
            <input type="number" name="cantidad" value="<%= product.cantidad %>" id="cantidad_input">
          </label><br>

          <label id="precio_unitario">Precio Unitario$
            <input type="number" name="precio_unitario" value="<%= product.precio_unitario %>" id="precio_unitario_input">
          </label><br>

          <label id="en_stock">
            <p>¿Está en stock?</p>
            <div class="in__line">
              <label for="si">Sí</label>

              <input type="radio" id="si" name="en_stock" value="1"
              <%= product.en_stock == 1 ? 'checked' : '' %>>

              <label for="no">No</label>

              <input type="radio" id="no" name="en_stock" value="0"
              <%= product.en_stock == 0 ? 'checked' : '' %>>

            </div>
          </label><br>

          <div>
            <label for="id_proveedor">Elige un Proveedor</label><br>
            <% if(proveedores_list.length > 0) { %>
              <select name="id_proveedor" id="id_proveedor" required>
                <% proveedores_list.forEach((p) => { %>
                  <option value="<%= p.id_proveedor %>"
                    <%= p.id_proveedor == product.id_proveedor ? 'selected' : '' %>>
                    <%= p.nombre %>
                  </option>
                <% }); %>
              </select>
            <% } %>
          </div>

          <br>

        <button class="formEntidad__submit" type="button" onclick="actualizarProducto('<%= product.id_producto %>')">Guardar Cambios</button>
      </form>
    </main>

    <script src="/javascripts/productos/actualizar_productos.js"></script>

</body>
<%-include("../components/footer.ejs")%>