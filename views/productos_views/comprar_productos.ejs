<%-include("../components/head.ejs")%>

  <body>
    <%-include("../components/nav.ejs")%>
    <main>
      <h1><%= title %></h1>

      <% if(productos_list.length <= 0) { %>
        <h2>No hay productos registrados</h2>
      <% }  %>

      <div class="formEntidad">
        <div class="row">
          <label>Método de Pago:</label>
          <select id="id_metodo">
            <% metodos_pago_list.forEach(m => { %>
              <option value="<%= m.id_metodo %>"><%= m.nombre %></option>
            <% }) %>
          </select>
        </div>

        <div id="lista-productos">
          <h3>Elegir Productos</h3>
          <table class="table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Producto</th>
                <th>Precio</th>
                <th>Cantidad</th>
                <th>Subtotal</th>
              </tr>
            </thead>
            <tbody>
              <% productos_list.forEach((p) => { %>
                <tr class="producto-fila" 
                    data-id="<%= p.id_producto %>" 
                    data-precio="<%= p.precio_unitario %>">
                  <td><%= p.id_producto %></td>
                  <td><%= p.nombre %></td>
                  <td>$<%= p.precio_unitario %></td>
                  <td>
                    <input type="number" class="cantidad-input" value="0" min="0" 
                          style="width: 60px;" onchange="calcularSubtotal(this)">
                  </td>
                  <td>
                    $<span class="subtotal-texto">0.00</span>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
          <h4>Total Venta: $<span id="total-general">0.00</span></h4>
          <button class="formEntidad__submit" type="button" onclick="enviarVenta()">Finalizar Venta de Productos</button>
        </div>
      </div>
    </main>

    <script src="/javascripts/productos/comprar_productos.js"></script>

  </body>

  <%-include("../components/footer.ejs")%>