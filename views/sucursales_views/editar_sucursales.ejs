<%-include("../components/head.ejs")%>

  <body>
    <%-include("../components/nav.ejs")%>
      <main>
        <h1><%= title %>: <%= sucursal.nombre %></h1> 

        <form class="formEntidad" id="formEditarSucursal">
          <label>Nombre
            <input type="text" id="nombre_input" name="nombre" value="<%= sucursal.nombre %>"> 
          </label><br>

          <label>Estado
            <input type="text" id="estado_input" name="estado" value="<%= sucursal.estado %>"> 
          </label><br>

          <label>Ciudad
            <input type="text" id="ciudad_input" name="ciudad" value="<%= sucursal.ciudad %>"> 
          </label><br>

          <label>Dirección
            <input type="text" id="direccion_input" name="direccion" value="<%= sucursal.direccion %>"> 
          </label><br>

          <button class="formEntidad__submit" type="button" onclick="actualizarSucursal('<%= sucursal.id_sucursal %>')">Guardar Cambios</button>
        </form>
      </main>

      <script src="/javascripts/sucursales/actualizar_sucursales.js"></script>

  </body>

  <%-include("../components/footer.ejs")%>