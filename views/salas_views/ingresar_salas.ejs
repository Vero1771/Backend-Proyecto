<%-include("../components/head.ejs")%>

  <body>
    <%-include("../components/nav.ejs")%>
    <main>
      <h1>Ingresar <%= title %></h1>

      <form class="formEntidad" id="formIngresarSala">
        <label>Nombre
          <input type="text" name="nombre" id="nombre_input">
        </label><br>

        <label>Capacidad
          <input type="number" name="capacidad" id="capacidad_input">
        </label><br>

        <div>
          <label for="id_sucursal">Elige una Sucursal</label><br>
          <% if(sucursales_list.length > 0) { %>
            <select name="id_sucursal" id="id_sucursal" required>
              <option value="" disabled selected>Selecciona una sucursal...</option>
              <% sucursales_list.forEach((s) => { %>
                <option value="<%= s.id_sucursal %>">
                  <%= s.nombre %>
                </option>
              <% }); %>
            </select>
          <% } else { %>
            <p>No hay sucursales para asignar</p>
          <% } %>
        </div>

        <br>

        <button class="formEntidad__submit" type="button" onclick="enviarFormulario()">Enviar</button>
      </form>
    </main>

    <script src="/javascripts/salas/ingresar_salas.js"></script>

  </body>

  <%-include("../components/footer.ejs")%>