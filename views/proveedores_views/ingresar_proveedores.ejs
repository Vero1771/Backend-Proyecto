<%-include("../components/head.ejs")%>

  <body>
    <%-include("../components/nav.ejs")%>
    <main>
      <h1>Ingresar <%= title %></h1>

      <form class="formEntidad" id="formIngresarProveedor">
        <label>Nombre
          <input type="text" name="nombre" id="nombre_input">
        </label><br>

        <label>Correo
          <input type="email" name="correo" id="correo_input">
        </label><br>

        <label>Teléfono
          <input type="text" name="telefono" id="telefono_input">
        </label><br>

        <label>Empresa
          <input type="text" name="empresa" id="empresa_input">
        </label><br>


        <button class="formEntidad__submit" type="button" onclick="enviarFormulario()">Enviar</button>
      </form>
    </main>

    <script src="/javascripts/proveedores/ingresar_proveedores.js"></script>

  </body>

  <%-include("../components/footer.ejs")%>