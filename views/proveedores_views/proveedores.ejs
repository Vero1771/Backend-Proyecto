<%-include("../components/head.ejs")%>
  <body>

    <%-include("../components/nav.ejs")%>

    <main>
      <h1><%= title %></h1>

      <% if(proveedores_list.length <= 0) { %>
        <h2>No hay proveedores registrados</h1>
      <% }  %>

      <table>
          <thead>
              <tr>
                  <th>ID</th>
                  <th>Nombre</th>
                  <th>Correo</th>
                  <th>Teléfono</th>
                  <th>Empresa</th>
                  <% if (user && user.rol === 'admin') { %>
                    <th>Administrar</th>
                  <% } %>
              </tr>
          </thead>
          <tbody>
              <% proveedores_list.forEach((p, i) => { %>
                  <tr>
                    <td><%= p.id_proveedor %></td>
                    <td><%= p.nombre %></td>
                    <td><%= p.correo %></td>
                    <td><%= p.telefono %></td>
                    <td><%= p.empresa %></td>
                    
                    <% if (user && user.rol === 'admin') { %>
                      <td>    
                        <div class="botonera">
                          <a class="botonera__opcion opcion__editar" href="/proveedores/actualizar/<%= p.id_proveedor %>" class="button">Editar</a>
                          <button class="botonera__opcion opcion__eliminar" onclick="eliminarProveedor(this, '<%= p.id_proveedor %>')"> X </button> 
                        </div>
                      </td>
                    <% } %>

                  </tr>
              <% }); %>
          </tbody>
      </table>

      <script>
        async function eliminarProveedor(boton, id) {
          if (!confirm('¿Estás seguro de eliminar este proveedor?')) return;

          try {
            const response = await fetch(`/proveedores/eliminar/${id}`, {
              method: 'DELETE', 
              headers: {
                'Content-Type': 'application/json'
              }
            });

            const data = await response.json(); 

            if (response.ok) {
              const fila = boton.closest('tr'); //eliminar la fila de la tabla sin recargar
              fila.remove();
                  
              const tbody = document.querySelector('tbody');
              if (tbody.children.length === 0) {
                location.reload(); 
              }
            } else {
              alert(data.message || 'Error al eliminar el proveedor');
            }
          } catch (error) {
            console.error('Error:', error);
            alert('Hubo un problema con la conexión');
          }
        }
      </script>

    </main>

  </body>

<%-include("../components/footer.ejs")%>