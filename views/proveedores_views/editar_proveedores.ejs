<%-include("../components/head.ejs")%>

  <body>
    <%-include("../components/nav.ejs")%>
      <main>
        <h1><%= title %>: <%= proveedor.nombre %></h1> 

        <form class="formEntidad" id="formEditarProveedor">
          <label>Nombre
            <input type="text" id="nombre_input" name="nombre" value="<%= proveedor.nombre %>"> 
          </label><br>

          <label>Correo
            <input type="email" name="correo" id="correo_input" value="<%= proveedor.correo %>">
          </label><br>

          <label>Teléfono
            <input type="text" name="telefono" id="telefono_input" value="<%= proveedor.telefono %>">
          </label><br>

          <label>Empresa
            <input type="text" name="empresa" id="empresa_input" value="<%= proveedor.empresa %>">
          </label><br>

          <button class="formEntidad__submit" type="button" onclick="actualizarProveedor('<%= proveedor.id_proveedor %>')">Guardar Cambios</button>
        </form>
      </main>

      <script src="/javascripts/proveedores/actualizar_proveedores.js"></script>

  </body>

  <%-include("../components/footer.ejs")%>