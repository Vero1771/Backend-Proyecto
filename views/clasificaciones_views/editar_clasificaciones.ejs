<%-include("../components/head.ejs")%>

  <body>
    <%-include("../components/nav.ejs")%>
      <main>
        <h1><%= title %>: <%= clasificacion.nombre %></h1>

        <form class="formEntidad" id="formEditarClasificacion">

          <label id="nombre">Nombre
            <input type="text" id="nombre_input" name="nombre" value="<%= clasificacion.nombre %>">
          </label><br>

          <button class="formEntidad__submit" type="button" onclick="actualizarClasificacion('<%= clasificacion.id_clasificacion %>')">Guardar Cambios</button>

        </form>
      </main>

      <script src="/javascripts/clasificaciones/actualizar_clasificaciones.js"></script>

  </body>

  <%-include("../components/footer.ejs")%>